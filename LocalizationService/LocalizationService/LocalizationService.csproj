    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Localization.Persistance\Localization.Persistence.csproj" />
    <ProjectReference Include="..\Infrastructure\Localization.Presentation Api\Localization.Presentation Api.csproj" />
  </ItemGroup>

</Project>
